#!/bin/sh
#
# $Id: update,v 1.4 2026-07-25 21:11:44+05:30 Cprogrammer Exp mbhangui $
#
case $1 in
	update)
	if [ -f /etc/debian_version ] ; then
		exec sudo env DEBIAN_FRONTEND=noninteractive apt update -y
	elif [ -f /usr/bin/dnf ] ; then
		exec sudo dnf -y update
	fi
	;;
	upgrade)
	if [ -d /service/audio-selector ] ; then
		sudo touch /service/audio-selector/.norestart
		ts_audio1=$(stat -c "%Y" /usr/lib/audio_selector)
	fi
	[ -d $HOME/.audio_selector ] && cd $HOME/.audio_selector || (mkdir -p $HOME/.audio_selector && cd $HOME/.audio_selector)
	if [ -f /etc/debian_version ] ; then
		sudo env DEBIAN_FRONTEND=noninteractive apt --allow-downgrades upgrade -y
	else
		sudo dnf -y upgrade
	fi
	ret=$?
	(
	if [ $ret -eq 0 ] ; then
		echo ""
		echo "=== UPDATE COMPLETED SUCCESSFULLY ==="
		echo "STATUS=COMPLETED"
	else
		echo ""
    	echo "=== EXECUTION FAILURE ==="
		echo "STATUS=FAILED"
	fi
	) | tee -a update_progress.log
	for i in restart update initialize
	do
		if [ -f $HOME/.audio_selector/$i -a ! -f $HOME/.audio_selector/$i.nooverwrite ] ; then
			ts1=$(stat -c "%Y" $HOME/.audio_selector/$i)
			ts2=$(stat -c "%Y" /usr/lib/audio_selector/$i)
			if [ -n "$ts1" -a -n "$ts2" -a $ts2 -gt $ts1 ] ; then
				echo "Updating script $HOME/.audio_selector/$i"
				if [ "$i" = "update" ] ; then
					mv $HOME/.audio_selector/update $HOME/.audio_selector/update.bak.
				fi
				cp /usr/lib/audio_selector/$i $HOME/.audio_selector/$i
			fi
		fi
	done
	if [ -d /service/audio-selector -a -f /service/audio-selector/.norestart ] ; then
		ts_audio2=$(stat -c "%Y" /usr/lib/audio_selector)
		if [ -n "$ts_audio1" -a -n "$ts_audio2" -a $ts_audio2 -gt $ts_audio1 ] ; then
			echo "Restarting audio-selector service"
			sudo svc -r /service/audio-selector
			if [ $? -eq 0 ] ; then
				sudo /bin/rm -f /service/audio-selector/.norestart
			fi
		else
			echo "No update to audio-selector detected"
			sudo /bin/rm -f /service/audio-selector/.norestart
		fi
	fi
	exit $ret
	;;
esac

